# Copy to .env (gitignored) and fill in. `podman compose` reads it for the dev
# container; export the IM_* lines in your shell (e.g. `set -a; . ./.env; set +a`).

# Dev container superuser and the pipeline role's password (local only).
POSTGRES_PASSWORD=change-me
IM_PIPELINE_PASSWORD=change-me-too

# The pipeline: role im_pipeline, owns im.* and nothing else.
IM_DATABASE_URL=postgresql://im_pipeline:change-me-too@127.0.0.1:55432/im_dev
# Lattice (the presentation app) reads schema pub as role lattice_app.
LATTICE_APP_PASSWORD=change-me-three
LATTICE_DATABASE_URL=postgresql://lattice_app:change-me-three@127.0.0.1:55432/im
# Local dev admin: tests only. Must point at localhost.
IM_DEV_ADMIN_URL=postgresql://postgres:change-me@127.0.0.1:55432/im_dev
# Hearsay's utterance stream, read-only. For fixtures: dev/stream with `im load-fixtures`.
# For real data: ~/.local/share/ideamachine/stream, filled by dev/pull-stream.sh, with database `im`.
IM_STREAM_DIR=dev/stream
# Claude, for idea extraction (docs/decisions/0004-claude-extraction.md). Or use an `ant auth login` profile.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: segmentation config (TOML). Defaults are in src/im/config.py.
# IM_CONFIG=im.toml

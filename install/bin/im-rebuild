#!/usr/bin/env bash
# `im-rebuild` on the NAS: `im` (install/bin/im) against the rebuild database, im_rebuild (decision 0012), with its
# own config, rebuild.toml. The same arguments as `im`, e.g. `im-rebuild pending`; no arguments is a pipeline run.
# install/rebuild.sh makes the database and its files; install/nas.sh puts this on root's PATH.
set -euo pipefail

# shellcheck source=SCRIPTDIR/../lib.sh
. "$(dirname "$0")/../lib.sh"
rebuild_env
exec "${COMPOSE[@]}" run --rm -v "$NAS_SAVED:/saved" "${REBUILD_RUN[@]}" run "$@"
